# ─────────────────────────────────────────────
#  Hot Wheels Tracker — Configuration
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Telegram Bot
# 1. Talk to @BotFather on Telegram → /newbot
# 2. Copy the token here
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID
# 1. Start your bot, send any message
# 2. Visit: https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Copy the "id" from the "chat" object
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Location ────────────────────────────────
# Used for Blinkit / Zepto / Swiggy / BigBasket
# Set this to YOUR delivery location
LOCATION_LAT=28.6139        # New Delhi (change to your coords)
LOCATION_LNG=77.2090
LOCATION_LABEL=New Delhi    # Human-readable label shown in notifications

# ─── Polling ─────────────────────────────────
# How often to check (in minutes) during normal hours
POLL_INTERVAL_MINUTES=15

# Restock windows — checks run every 2 min during these times (24h format, IST)
# Blinkit typically restocks around 6am, 10am, 2pm, 6pm
RESTOCK_WINDOWS=06:00-06:30,10:00-10:30,14:00-14:30,18:00-18:30
